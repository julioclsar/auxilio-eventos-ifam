# Copie para .env e preencha. Nunca publique o .env.

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=troque-por-um-valor-longo-e-aleatorio

# Endereço pelo qual o sistema será acessado, sem https://
DJANGO_ALLOWED_HOSTS=auxilio.exemplo.com.br
# Com https://
DJANGO_CSRF_TRUSTED_ORIGINS=https://auxilio.exemplo.com.br

# Deixe 1 se houver HTTPS na frente do sistema (recomendado, são dados pessoais). Use 0 só em teste local.
DJANGO_FORCAR_HTTPS=1

# 1 recusa PDF sem assinatura digital detectada. 0 aceita e mostra alerta (padrão).
ASSINATURA_ESTRITA=0
